# Copy to .env next to docker-compose.yml.

# Image tag: a release ("0.1" follows 0.1.x patches, "0.1.0" pins one), or "edge" (latest main).
FORMKILN_VERSION=0.1

# Database password (any long random string).
POSTGRES_PASSWORD=
# 32 random bytes, Base64: openssl rand -base64 32. Keep it safe: it encrypts sensitive data.
FORMKILN_ENCRYPTION_KEY=
# Invited as the first admin when there are no members yet.
FORMKILN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Public URLs (used in emails and share links).
FORMKILN_ADMIN_URL=http://localhost:3200
FORMKILN_HOSTED_URL=http://localhost:3100

# Bearer token for automation on the management API. Leave empty to disable it.
FORMKILN_SERVICE_TOKEN=

# Bearer token for Prometheus scraping of server:8080/actuator/prometheus. Leave empty to disable.
FORMKILN_METRICS_TOKEN=

# SMTP. Defaults to the mailpit profile.
# FORMKILN_SMTP_HOST=smtp.example.com
# FORMKILN_SMTP_PORT=587
# FORMKILN_MAIL_FROM=Formkiln <forms@example.com>

# Sites allowed to embed hosted forms in an iframe.
# FORMKILN_FRAME_ANCESTORS='self' https://app.example.com

# Cloudflare Turnstile for public forms.
# FORMKILN_TURNSTILE_SITE_KEY=
# FORMKILN_TURNSTILE_SECRET=

# TTF font for submission PDFs with non-Latin text (Chinese, for example); the default font
# covers Western European languages. The path is inside the server container.
# FORMKILN_PDF_FONT=/fonts/NotoSansSC-Regular.ttf
