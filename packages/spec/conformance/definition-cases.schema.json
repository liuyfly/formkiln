{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formkiln definition conformance cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "cases"],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "form", "expected"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "form": {
            "type": "object"
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pointer", "code"],
              "properties": {
                "pointer": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
