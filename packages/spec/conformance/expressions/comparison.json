{
  "description": "Strict equality and numeric ordering.",
  "cases": [
    {
      "name": "1 equals 1.0",
      "expression": {
        "==": [1, 1.0]
      },
      "expected": true
    },
    {
      "name": "no type coercion",
      "expression": {
        "==": ["1", 1]
      },
      "expected": false
    },
    {
      "name": "null equals null",
      "expression": {
        "==": [null, null]
      },
      "expected": true
    },
    {
      "name": "arrays compare element-wise",
      "expression": {
        "==": [
          [1, 2],
          [1, 2]
        ]
      },
      "expected": true
    },
    {
      "name": "objects ignore key order",
      "expression": {
        "==": [
          {
            "var": "a"
          },
          {
            "var": "b"
          }
        ]
      },
      "data": {
        "a": {
          "x": 1,
          "y": 2
        },
        "b": {
          "y": 2,
          "x": 1
        }
      },
      "expected": true
    },
    {
      "name": "0 is not null",
      "expression": {
        "!=": [0, null]
      },
      "expected": true
    },
    {
      "name": "less than",
      "expression": {
        "<": [1, 2]
      },
      "expected": true
    },
    {
      "name": "string operand makes ordering false",
      "expression": {
        "<": ["1", 2]
      },
      "expected": false
    },
    {
      "name": "null operand makes ordering false",
      "expression": {
        ">=": [null, 0]
      },
      "expected": false
    },
    {
      "name": "between, exclusive",
      "expression": {
        "<": [1, 2, 3]
      },
      "expected": true
    },
    {
      "name": "between, exclusive upper bound",
      "expression": {
        "<": [1, 3, 3]
      },
      "expected": false
    },
    {
      "name": "between, inclusive",
      "expression": {
        "<=": [1, 3, 3]
      },
      "expected": true
    }
  ]
}
