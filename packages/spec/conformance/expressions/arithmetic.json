{
  "description": "Numbers are IEEE 754 doubles; invalid operations give null.",
  "cases": [
    {
      "name": "sum",
      "expression": {
        "+": [1, 2, 3]
      },
      "expected": 6
    },
    {
      "name": "null operand gives null",
      "expression": {
        "+": [1, null]
      },
      "expected": null
    },
    {
      "name": "string operand gives null",
      "expression": {
        "+": ["1", 2]
      },
      "expected": null
    },
    {
      "name": "unary minus",
      "expression": {
        "-": [5]
      },
      "expected": -5
    },
    {
      "name": "difference",
      "expression": {
        "-": [5, 7]
      },
      "expected": -2
    },
    {
      "name": "division",
      "expression": {
        "/": [7, 2]
      },
      "expected": 3.5
    },
    {
      "name": "division by zero gives null",
      "expression": {
        "/": [1, 0]
      },
      "expected": null
    },
    {
      "name": "remainder takes the sign of the dividend",
      "expression": {
        "%": [-7, 3]
      },
      "expected": -1
    },
    {
      "name": "binary floating point is preserved",
      "expression": {
        "*": [0.1, 3]
      },
      "expected": 0.30000000000000004
    },
    {
      "name": "min",
      "expression": {
        "min": [3, 1, 2]
      },
      "expected": 1
    },
    {
      "name": "max with null gives null",
      "expression": {
        "max": [3, null]
      },
      "expected": null
    },
    {
      "name": "round half away from zero on decimal representation",
      "expression": {
        "round": [1.005, 2]
      },
      "expected": 1.01
    },
    {
      "name": "round negative half away from zero",
      "expression": {
        "round": [-2.5]
      },
      "expected": -3
    },
    {
      "name": "round positive half away from zero",
      "expression": {
        "round": [2.5]
      },
      "expected": 3
    },
    {
      "name": "round to integer",
      "expression": {
        "round": [1234.5678, 0]
      },
      "expected": 1235
    }
  ]
}
