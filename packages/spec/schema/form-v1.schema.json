{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyfly/formkiln/blob/main/packages/spec/schema/form-v1.schema.json",
  "title": "Formkiln form document, schema version 1",
  "description": "Structural schema for Formkiln form documents. Semantic rules (unique keys, references, cycles, value types) are defined in docs/form-schema-v1.md section 10.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "title", "pages"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "key": {
      "$ref": "#/$defs/key"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "submit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
    },
    "elementId": {
      "description": "Stable identifier of an element across versions and key changes (§5.6). Never part of answers.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "width": {
      "description": "Columns the element spans on its container's grid (§5.5); at most settings.layout.columns.",
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/locale"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "description": "Free-form host data. Ignored by implementations."
    },
    "expression": {
      "description": "Formkiln expression: JSON Logic syntax, Formkiln semantics (see docs/operators-v1.md).",
      "oneOf": [
        {
          "type": ["null", "boolean", "number", "string"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "var",
              "and",
              "or",
              "!",
              "if",
              "==",
              "!=",
              "<",
              "<=",
              ">",
              ">=",
              "+",
              "-",
              "*",
              "/",
              "%",
              "min",
              "max",
              "round",
              "empty",
              "cat",
              "length",
              "lower",
              "upper",
              "matches",
              "date.today",
              "date.add",
              "date.diff",
              "in",
              "some",
              "all",
              "none",
              "map",
              "filter",
              "sum"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "enum": ["paged", "single"]
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "defaultLocale": {
          "$ref": "#/$defs/locale"
        },
        "locales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "inactiveValues": {
          "enum": ["retain", "clear"]
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "description": "Number of equal columns of the layout grid (§5.5). Default 3.",
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "elements"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "visible": {
          "$ref": "#/$defs/condition"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "element": {
      "oneOf": [
        {
          "$ref": "#/$defs/content"
        },
        {
          "$ref": "#/$defs/panel"
        },
        {
          "$ref": "#/$defs/repeater"
        },
        {
          "$ref": "#/$defs/field"
        }
      ]
    },
    "itemElement": {
      "oneOf": [
        {
          "$ref": "#/$defs/content"
        },
        {
          "$ref": "#/$defs/itemPanel"
        },
        {
          "$ref": "#/$defs/field"
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "text"],
      "properties": {
        "type": {
          "const": "content"
        },
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "format": {
          "enum": ["plain", "markdown"]
        },
        "visible": {
          "$ref": "#/$defs/condition"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "elements"],
      "properties": {
        "type": {
          "const": "panel"
        },
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "visible": {
          "$ref": "#/$defs/condition"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "itemPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "elements"],
      "properties": {
        "type": {
          "const": "panel"
        },
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "visible": {
          "$ref": "#/$defs/condition"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/itemElement"
          }
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "repeater": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "label", "elements"],
      "properties": {
        "type": {
          "const": "repeater"
        },
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "itemLabel": {
          "$ref": "#/$defs/text"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "visible": {
          "$ref": "#/$defs/condition"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/itemElement"
          }
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "fieldCommon": {
      "type": "object",
      "required": ["type", "key", "label"],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "hideLabel": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "required": {
          "$ref": "#/$defs/condition"
        },
        "requiredMessage": {
          "$ref": "#/$defs/text"
        },
        "readOnly": {
          "$ref": "#/$defs/condition"
        },
        "defaultValue": {
          "description": "Initial value; must match the field's value type."
        },
        "calculate": {
          "$ref": "#/$defs/expression"
        },
        "validators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validator"
          }
        },
        "sensitive": {
          "type": "boolean"
        },
        "autocomplete": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "$ref": "#/$defs/condition"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "valueType": {
      "enum": [
        "string",
        "number",
        "boolean",
        "date",
        "time",
        "datetime",
        "string[]",
        "file[]",
        "name",
        "address"
      ]
    },
    "nameParts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["title", "given", "middle", "family"]
      }
    },
    "addressParts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["line1", "line2", "city", "region", "postalCode", "country"]
      }
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "placeholder": {
              "$ref": "#/$defs/text"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "textarea"
            },
            "placeholder": {
              "$ref": "#/$defs/text"
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "email"
            },
            "placeholder": {
              "$ref": "#/$defs/text"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "phone"
            },
            "placeholder": {
              "$ref": "#/$defs/text"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "url"
            },
            "placeholder": {
              "$ref": "#/$defs/text"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "placeholder": {
              "$ref": "#/$defs/text"
            },
            "prefix": {
              "$ref": "#/$defs/text"
            },
            "suffix": {
              "$ref": "#/$defs/text"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "radio"
            },
            "options": {
              "$ref": "#/$defs/options"
            }
          },
          "unevaluatedProperties": false,
          "required": ["options"]
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "select"
            },
            "placeholder": {
              "$ref": "#/$defs/text"
            },
            "options": {
              "$ref": "#/$defs/options"
            }
          },
          "unevaluatedProperties": false,
          "required": ["options"]
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "checkboxes"
            },
            "options": {
              "$ref": "#/$defs/options"
            }
          },
          "unevaluatedProperties": false,
          "required": ["options"]
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "display": {
              "enum": ["checkbox", "switch", "yesNo"]
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "date"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "time"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "datetime"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "file"
            },
            "multiple": {
              "type": "boolean"
            },
            "accept": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "name"
            },
            "parts": {
              "$ref": "#/$defs/nameParts"
            },
            "requiredParts": {
              "$ref": "#/$defs/nameParts"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "address"
            },
            "parts": {
              "$ref": "#/$defs/addressParts"
            },
            "requiredParts": {
              "$ref": "#/$defs/addressParts"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/fieldCommon"
            }
          ],
          "properties": {
            "type": {
              "const": "hidden"
            },
            "valueType": {
              "$ref": "#/$defs/valueType"
            }
          },
          "unevaluatedProperties": false,
          "required": ["valueType"]
        }
      ]
    },
    "validator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "minLength"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "maxLength"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "pattern"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "min"
            },
            "value": {
              "type": "number"
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "max"
            },
            "value": {
              "type": "number"
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "minDate"
            },
            "value": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "object",
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "maxDate"
            },
            "value": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "object",
                  "$ref": "#/$defs/expression"
                }
              ]
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "minItems"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "maxItems"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "maxFileSize"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "fileTypes"
            },
            "value": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "equals"
            },
            "value": {},
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "integer"
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rule", "message"],
          "properties": {
            "type": {
              "const": "expression"
            },
            "rule": {
              "$ref": "#/$defs/expression"
            },
            "message": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "redirect": {
          "type": "string",
          "pattern": "^(https://|/)"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    }
  }
}
